{
  "manifest_version": 3,
  "name": "GATE 2027 Prep Tracker & Blocker",
  "version": "1.1.0",
  "description": "Track your GATE 2027 preparation — countdown, focus time, todos, and IISc OP YouTube focus blocker.",
  "permissions": ["storage", "alarms", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GATE 2027 Prep Tracker",
    "default_icon": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "iisc.jpg",
        "icons/*"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content-tracker.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": ["blocker.css"],
      "js": ["content-blocker.js"],
      "run_at": "document_start"
    }
  ]
}
